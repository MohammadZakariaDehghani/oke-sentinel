# ---------------------------------------------------------------------------
# Credentials and local state. Nothing in this section should ever be
# committed: the repository is public and contains no real tenancy data.
# ---------------------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*_rsa
*_rsa.pub
oci_api_key*
.oci/
config.oci

# Terraform variable files hold real OCIDs. Only *.tfvars.example is tracked.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Kubeconfigs contain cluster endpoints and tokens.
kubeconfig
kubeconfig-*
*.kubeconfig

# Environment files
.env
.env.*
!.env.example

