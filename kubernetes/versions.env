# Single source of truth for the versions the install scripts and CI use.
# Bump here, not in the manifests.
#
# Verified current at the time of writing:
#   ECK 3.5.0        - the operator; ECK 3.x is required for Stack 9.x
#   Stack 9.5.0      - Elasticsearch, Kibana, Filebeat, Metricbeat
#   ESO 0.20.4       - External Secrets Operator, for the OCI Vault provider

ECK_VERSION=3.5.0
STACK_VERSION=9.5.0
EXTERNAL_SECRETS_VERSION=0.20.4

# Where the operator manifests come from. crds.yaml must be applied before
# operator.yaml.
ECK_CRDS_URL=https://download.elastic.co/downloads/eck/${ECK_VERSION}/crds.yaml
ECK_OPERATOR_URL=https://download.elastic.co/downloads/eck/${ECK_VERSION}/operator.yaml
