# Copy to backend.hcl and fill in, then:
#   terraform init -backend-config=backend.hcl
#
# backend.hcl is gitignored. It holds no credentials — those come from
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY in the environment — but it does
# name your tenancy's Object Storage namespace, so it stays out of the repo.

bucket = "oke-sentinel-tfstate"
key    = "prod/terraform.tfstate"

# Your OCI region. Not an AWS region, hence skip_region_validation below.
region = "eu-frankfurt-1"

# https://<object-storage-namespace>.compat.objectstorage.<region>.oraclecloud.com
# The namespace is the `object_storage_namespace` output from the bootstrap stack.
endpoints = {
  s3 = "https://exampleNamespace.compat.objectstorage.eu-frankfurt-1.oraclecloud.com"
}

# Object Storage is S3-compatible, not S3. Each of these switches off a check
# or a header that only makes sense against real AWS:
#   skip_region_validation      - "eu-frankfurt-1" is not in the AWS region list
#   skip_credentials_validation - there is no STS endpoint to call
#   skip_requesting_account_id  - there is no AWS account to look up
#   skip_metadata_api_check     - there is no EC2 instance metadata service
#   skip_s3_checksum            - OCI rejects the trailing checksum header that
#                                 newer AWS SDKs send by default
#   use_path_style              - buckets are a path segment, not a subdomain
skip_region_validation      = true
skip_credentials_validation = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
use_path_style              = true
